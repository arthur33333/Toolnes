
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover free online puzzles and games on Toolnes. Create word searches, solve number puzzles and play 2048.">
  <meta name="robots" content="index, follow">
  <title>Puzzles & Games - Toolnes</title>
  <link rel="canonical" href="https://toolnes.netlify.app/puzzles/">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #182230;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #e5eaf2;
      padding: 20px;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 26px;
      font-weight: 800;
      color: #2563eb;
      text-decoration: none;
    }

    nav a {
      margin-left: 18px;
      text-decoration: none;
      color: #334155;
      font-weight: 600;
    }

    nav a:hover {
      color: #2563eb;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 45px 20px 60px;
    }

    .hero {
      text-align: center;
      margin-bottom: 38px;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 46px);
      margin: 0 0 14px;
      letter-spacing: -1px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #64748b;
      line-height: 1.7;
      font-size: 17px;
    }

    .games-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .game-card {
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5eaf2;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
      transition: transform 0.2s, box-shadow 0.2s;
      min-height: 260px;
    }

    .game-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.09);
    }

    .game-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 60px;
      border-radius: 14px;
      background: #eff6ff;
      font-size: 32px;
      margin-bottom: 18px;
    }

    .game-card h2 {
      font-size: 21px;
      margin: 0 0 10px;
    }

    .game-card p {
      color: #64748b;
      line-height: 1.6;
      margin: 0 0 22px;
      flex: 1;
    }

    .game-button {
      display: inline-block;
      text-align: center;
      padding: 12px 16px;
      border-radius: 9px;
      background: #2563eb;
      color: white;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s;
    }

    .game-button:hover {
      background: #1d4ed8;
    }

    .coming-soon {
      display: inline-block;
      text-align: center;
      padding: 12px 16px;
      border-radius: 9px;
      background: #eef2f7;
      color: #64748b;
      font-weight: 700;
    }

    .featured {
      border: 2px solid #2563eb;
    }

    footer {
      text-align: center;
      padding: 25px 20px;
      background: #ffffff;
      border-top: 1px solid #e5eaf2;
      color: #64748b;
    }

    footer a {
      color: #2563eb;
      text-decoration: none;
    }

    @media (max-width: 850px) {
      .games-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .games-grid {
        grid-template-columns: 1fr;
      }

      main {
        padding-top: 30px;
      }

      .game-card {
        min-height: 230px;
      }

      nav a {
        margin-left: 0;
        margin-right: 12px;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="header-inner">
      <a class="logo" href="/">Toolnes</a>

      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/text-tools/">Text Tools</a>
        <a href="/calculators/">Calculators</a>
        <a href="/puzzles/" aria-current="page">Puzzles</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <h1>Puzzles &amp; Games</h1>
      <p>
        Enjoy free online puzzles and games on Toolnes.
        Create your own word puzzles, challenge your brain,
        and have fun anytime on desktop or mobile.
      </p>
    </section>

    <section class="games-grid" aria-label="Available puzzles and games">

      <!-- Word Search -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">🔎</div>
        <h2>Word Search</h2>
        <p>
          Create word search puzzles with your own words.
          Generate a puzzle and print it for free.
        </p>
        <a class="game-button" href="/puzzles/word-search/">
          Create Word Search
        </a>
      </article>

      <!-- Crossword Generator -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">📝</div>
        <h2>Crossword Generator</h2>
        <p>
          Create crossword puzzles for learning, classrooms,
          activities, and entertainment.
        </p>
        <span class="coming-soon">Coming Soon</span>
      </article>

      <!-- Sudoku -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">🔢</div>
        <h2>Sudoku Generator</h2>
        <p>
          Challenge your logic with number puzzles
          for different skill levels.
        </p>
        <span class="coming-soon">Coming Soon</span>
      </article>

      <!-- Maze Generator -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">🌀</div>
        <h2>Maze Generator</h2>
        <p>
          Generate mazes to solve, print, and enjoy
          with friends or family.
        </p>
        <span class="coming-soon">Coming Soon</span>
      </article>

      <!-- Word Scramble -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">🔤</div>
        <h2>Word Scramble</h2>
        <p>
          Unscramble mixed-up letters and test your
          vocabulary with word challenges.
        </p>
        <span class="coming-soon">Coming Soon</span>
      </article>

      <!-- Bingo Generator -->
      <article class="game-card">
        <div class="game-icon" aria-hidden="true">🎯</div>
        <h2>Bingo Generator</h2>
        <p>
          Create custom bingo cards for parties,
          classrooms, and group activities.
        </p>
        <span class="coming-soon">Coming Soon</span>
      </article>

      <!-- 2048 Game -->
      <article class="game-card featured">
        <div class="game-icon" aria-hidden="true">🧩</div>
        <h2>2048 Game</h2>
        <p>
          Merge matching number tiles, build bigger numbers,
          and try to reach 2048 in this addictive puzzle game.
        </p>
        <a class="game-button" href="/puzzles/2048/">
          Play 2048
        </a>
      </article>

    </section>
  </main>

  <footer>
    <p>
      &copy; <span id="year"></span> Toolnes.
      Free online tools and games.
    </p>
    <p><a href="/">Back to Toolnes Home</a></p>
  </footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
